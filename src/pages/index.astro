---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const services = [
  {
    title: 'Web Design & Website Design',
    text: 'Custom, fast-loading small business websites built on modern tools — no bloated page builders.',
  },
  {
    title: 'Landing Page Design',
    text: 'Conversion-focused websites built around one goal: turning visitors into leads, calls, or sales.',
  },
  {
    title: 'SEO',
    text: 'On-page and technical SEO so your website actually gets found on Google.',
  },
  {
    title: 'Digital Marketing',
    text: 'Ongoing content, email, and campaign support to keep bringing visitors back.',
  },
  {
    title: 'Branding & UI Design',
    text: 'A clean visual identity and component system so every page feels consistent.',
  },
];

const testimonials = [
  {
    quote: 'They rebuilt our site in three weeks and it finally looks like a real business. Inquiries picked up almost immediately.',
    name: 'Placeholder Client',
    role: 'Owner, Local Service Business',
  },
  {
    quote: 'Clear communication, fast turnaround, and the site actually loads instantly on mobile. Exactly what we needed.',
    name: 'Placeholder Client',
    role: 'Founder, Early-Stage Startup',
  },
];
---

<Layout
  title="MGR Digital Studio | Web Design, Landing Pages & SEO in Ottawa, Ontario"
  description="MGR Digital Studio designs conversion-focused websites, landing pages, and digital marketing for small businesses in Ottawa, across Ontario, and Canada-wide."
>
  <section class="hero">
    <div class="container">
      <div>
        <span class="eyebrow" style="color: #8b8ffb;">Web Design & Digital Marketing — Ottawa, Ontario</span>
        <h1>Websites built to convert</h1>
        <p class="lead">
          We design and build fast, mobile-friendly websites, landing pages, and small
          business websites — engineered to turn visitors into leads and customers,
          not just page views. Based in Ottawa, serving businesses across Ontario and Canada.
        </p>
        <div class="hero-badges">
          <span>Mobile-first builds</span>
          <span>SEO-ready from day one</span>
          <span>Launch in 2–4 weeks</span>
          <span>Fixed-price quotes</span>
        </div>
      </div>

      <ContactForm compact={true} heading="Get your free site plan" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center" style="max-width: 640px; margin: 0 auto 48px;">
        <span class="eyebrow">What we do</span>
        <h2>Everything your website needs to earn its keep</h2>
      </div>
      <div class="grid grid-3">
        {services.map((service) => (
          <div class="card">
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="center" style="max-width: 640px; margin: 0 auto 48px;">
        <span class="eyebrow">Recent work</span>
        <h2>A few projects we've shipped</h2>
      </div>
      <div class="grid grid-3">
        <a href="/portfolio" class="card" style="text-decoration:none;">
          <div class="thumb">Project One</div>
          <h3>Service Business Rebrand</h3>
          <p>Full redesign and rebuild focused on lead-gen.</p>
        </a>
        <a href="/portfolio" class="card" style="text-decoration:none;">
          <div class="thumb">Project Two</div>
          <h3>Startup Landing Page</h3>
          <p>High-conversion single page for a product launch.</p>
        </a>
        <a href="/portfolio" class="card" style="text-decoration:none;">
          <div class="thumb">Project Three</div>
          <h3>Local Business Site</h3>
          <p>Multi-page site with booking and local SEO.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center" style="max-width: 640px; margin: 0 auto 48px;">
        <span class="eyebrow">What clients say</span>
        <h2>Trusted by small businesses and founders</h2>
      </div>
      <div class="grid grid-2">
        {testimonials.map((t) => (
          <div class="testimonial">
            <p>&ldquo;{t.quote}&rdquo;</p>
            <div class="testimonial-author">
              <div class="avatar">{t.name.charAt(0)}</div>
              <div>
                <strong>{t.name}</strong><br />
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <!--
        TODO before launch: replace these with real client testimonials
        (with permission), or remove the section if none are available yet.
      -->
    </div>
  </section>

  <section class="section section-alt">
    <div class="container center" style="max-width: 720px; margin: 0 auto;">
      <span class="eyebrow">Where we work</span>
      <h2>Proudly based in Ottawa, serving all of Ontario and Canada</h2>
      <p>
        Whether you're a small business in Ottawa, elsewhere in Ontario, or
        anywhere else in Canada, we work with clients remotely — video calls,
        email, and a clear project plan, wherever you're located.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Ready to build a website that actually converts?</h2>
        <p>Tell us about your project — it takes two minutes, and there's no obligation.</p>
        <a href="/contact" class="btn btn-primary">Start your free quote</a>
      </div>
    </div>
  </section>
</Layout>
