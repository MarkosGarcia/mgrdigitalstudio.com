---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Web Design & Development',
    text: "A custom-designed, hand-coded website — not a generic template. Built for speed, accessibility, and easy editing, on modern tools instead of bloated page builders.",
    items: ['Custom design in your brand', 'Fast, mobile-first build', 'CMS or content collection for easy edits', 'Analytics set up from day one'],
  },
  {
    title: 'Conversion-Focused Landing Pages',
    text: 'A dedicated page for a campaign, ad, or launch — structured around a single goal instead of trying to say everything at once.',
    items: ['Clear, benefit-driven headline', 'Contact or sign-up form above the fold', 'Mobile-tested forms and buttons', 'Built-in social proof section'],
  },
  {
    title: 'Branding & UI Design',
    text: 'A simple, consistent visual identity — logo mark, colors, type, and a small component system — so every page and email looks like the same business.',
    items: ['Logo and color palette', 'Typography system', 'Reusable UI components', 'Brand style sheet'],
  },
  {
    title: 'Care, SEO & Updates',
    text: 'Websites need upkeep. We handle small edits, monitor uptime and performance, and keep search visibility improving after launch.',
    items: ['Monthly content or copy edits', 'Core Web Vitals monitoring', 'On-page SEO improvements', 'Security and dependency updates'],
  },
];
---

<Layout
  title="Services"
  description="Web design, development, landing pages, branding, and ongoing care from MGR Digital Studio."
>
  <section class="section">
    <div class="container">
      <div class="center" style="max-width: 680px; margin: 0 auto 56px;">
        <span class="eyebrow">Services</span>
        <h1>Everything you need to launch and grow online</h1>
        <p>Pick a single project or an ongoing package — every engagement starts with a fixed-price quote, no surprises.</p>
      </div>

      <div class="stack">
        {services.map((service) => (
          <div class="card">
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <div>
              {service.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="cta-band" style="background: var(--color-hero-bg);">
        <h2>Not sure which service fits your project?</h2>
        <p>Send us a few details and we'll recommend the right starting point — for free.</p>
        <a href="/contact" class="btn btn-primary">Get a free recommendation</a>
      </div>
    </div>
  </section>
</Layout>
