---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Contact MGR Digital Studio"
  description="Get in touch with MGR Digital Studio, Ottawa, for a free website, landing page, or SEO quote — serving businesses across Ontario and Canada."
>
  <section class="section">
    <div class="container">
      <div class="grid grid-2 grid-plain" style="align-items: start; gap: 48px;" data-reveal>
        <div>
          <span class="eyebrow">Contact</span>
          <h1>Let's talk about your project</h1>
          <p>
            Fill in the form and we'll reply within one business day with a
            recommendation and a fixed-price quote. No obligation, no sales
            calls unless you want one.
          </p>

          <div class="stack" style="margin-top: 32px;">
            <div>
              <strong>Email</strong>
              <p><a href="mailto:info@mgrdigitalstudio.com">info@mgrdigitalstudio.com</a></p>
            </div>
            <div>
              <strong>Phone / WhatsApp</strong>
              <p>
                <a href="tel:+16135137243">+1 613-513-7243</a>
                &middot;
                <a href="https://wa.me/16135137243" target="_blank" rel="noopener">Message on WhatsApp</a>
              </p>
            </div>
            <div>
              <strong>Response time</strong>
              <p>Within 1 business day</p>
            </div>
            <div>
              <strong>Address</strong>
              <p>
                <a href="https://maps.google.com/?q=702+Maloja+Way,+Stittsville,+Ottawa,+ON+K2S+0N6" target="_blank" rel="noopener">
                  702 Maloja Way, Stittsville, Ottawa, ON K2S 0N6
                </a>
              </p>
            </div>
          </div>
        </div>

        <ContactForm heading="Send us a message" subheading="We'll get back to you within 1 business day." />
      </div>
    </div>
  </section>
</Layout>
