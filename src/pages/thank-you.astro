---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank you" description="Thanks for reaching out to MGR Digital Studio.">
  <section class="section">
    <div class="container center" style="max-width: 640px;">
      <span class="eyebrow">Message sent</span>
      <h1>Thanks — we've got your message</h1>
      <p>
        We reply personally to every inquiry, usually within 1 business day.
        In the meantime, if you'd like to talk it through live, feel free to
        book a free 15-minute call at a time that works for you.
      </p>
      <a
        href="https://calendly.com/mgrdigitalstudio/intro-call"
        class="btn btn-primary"
        rel="noopener"
      >
        Book a free 15-minute call
      </a>
      <p class="text-sm" style="margin-top: 32px;">
        <a href="/">&larr; Back to homepage</a>
      </p>
    </div>
  </section>
</Layout>
