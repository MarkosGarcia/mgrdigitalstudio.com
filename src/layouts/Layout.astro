---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'MGR Digital Studio designs conversion-focused websites, landing pages, and digital marketing for small businesses in Ottawa, Ontario, and across Canada.',
} = Astro.props;

const pageTitle = title.includes('MGR Digital Studio') ? title : `${title} · MGR Digital Studio`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'MGR Digital Studio',
  url: 'https://mgrdigitalstudio.com',
  description:
    'Web design, landing page design, SEO, and digital marketing for small businesses in Ottawa, Ontario, and across Canada.',
  areaServed: [
    { '@type': 'City', name: 'Ottawa' },
    { '@type': 'AdministrativeArea', name: 'Ontario' },
    { '@type': 'Country', name: 'Canada' },
  ],
  knowsAbout: [
    'Web Design',
    'Website Design',
    'Landing Page Design',
    'Small Business Websites',
    'Conversion-Focused Websites',
    'SEO',
    'Digital Marketing',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
