---
interface Props {
  heading?: string;
  subheading?: string;
  compact?: boolean;
}

const {
  heading = 'Get your free site plan',
  subheading = "Tell us about your project. We'll reply within 1 business day with next steps — no obligation.",
  compact = false,
} = Astro.props;

const formId = compact ? 'hero-contact-form' : 'contact-form';
---

<div class="form-card" id={formId}>
  {compact ? <h3>{heading}</h3> : <h2>{heading}</h2>}
  <p class="form-sub">{subheading}</p>

  <div class="form-alert form-alert-error" data-form-alert role="alert"></div>

  <form method="POST" action="/api/contact">
    <input type="hidden" name="redirect" value="/thank-you" />
    <input type="hidden" name="source" value={compact ? 'home-hero' : 'contact-page'} />

    <!-- Honeypot: left blank by humans, often filled in by bots -->
    <div class="hp-field" aria-hidden="true">
      <label for={`${formId}-company`}>Company</label>
      <input type="text" id={`${formId}-company`} name="company_website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label for={`${formId}-name`}>Name</label>
      <input
        type="text"
        id={`${formId}-name`}
        name="name"
        autocomplete="name"
        placeholder="Jane Smith"
        required
      />
    </div>

    <div class="field">
      <label for={`${formId}-email`}>Email</label>
      <input
        type="email"
        id={`${formId}-email`}
        name="email"
        autocomplete="email"
        placeholder="jane@company.com"
        required
      />
    </div>

    <div class="field">
      <label for={`${formId}-message`}>What do you need?</label>
      <textarea
        id={`${formId}-message`}
        name="message"
        placeholder="A short description of your project or goal"
        required
      ></textarea>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Send &amp; get my free plan</button>
    <p class="form-note">No spam. We reply personally, within 1 business day.</p>
  </form>
</div>

<script>
  const params = new URLSearchParams(window.location.search);
  const errorCode = params.get('error');

  if (errorCode) {
    const messages: Record<string, string> = {
      validation: 'Please fill in your name, a valid email, and a short message.',
      spam: 'Your message looks like spam. If this is a mistake, please email us directly.',
      send: "Something went wrong sending your message. Please try again or email us at info@mgrdigitalstudio.com.",
      config: 'This form is not fully configured yet. Please email us directly at info@mgrdigitalstudio.com.',
    };

    document.querySelectorAll('[data-form-alert]').forEach((el) => {
      el.textContent = messages[errorCode] ?? messages.send;
      el.classList.add('is-visible');
    });

    params.delete('error');
    const newSearch = params.toString();
    const newUrl = window.location.pathname + (newSearch ? `?${newSearch}` : '') + window.location.hash;
    window.history.replaceState({}, '', newUrl);
  }
</script>
